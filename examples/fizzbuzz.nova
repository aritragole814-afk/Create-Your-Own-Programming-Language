// 08: FizzBuzz Algorithm in NovaLang
// Demonstrates loops, modulo '%', and conditionals

print("--- FizzBuzz from 1 to 20 ---");

let i = 1;

while (i <= 20) {
    let div_by_3 = (i % 3 == 0);
    let div_by_5 = (i % 5 == 0);

    if (div_by_3 and div_by_5) {
        print(i, "-> FizzBuzz");
    } else if (div_by_3) {
        print(i, "-> Fizz");
    } else if (div_by_5) {
        print(i, "-> Buzz");
    } else {
        print(i);
    }

    i = i + 1;
}

print("FizzBuzz complete!");
